    "customApis":  [
                       {
                           "uniqueName":  "mth_SendPartnerEmail",
                           "displayName":  "Send Partner E-mail",
                           "description":  "Sends one tender e-mail for one collaborating partner to its selected contacts from the calling user, regarding the partner. Status 10 -\u003e 24. SendToSelf sends a test to the caller.",
                           "type":  "Mth.Crm.Plugins.SendPartnerEmail",
                           "isFunction":  false,
                           "request":  [
                                           {
                                               "name":  "PartnerId",
                                               "type":  "Guid",
                                               "optional":  false
                                           },
                                           {
                                               "name":  "Subject",
                                               "type":  "String",
                                               "optional":  false
